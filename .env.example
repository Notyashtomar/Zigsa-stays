# SQLite file lives next to the Prisma schema (prisma/dev.db)
DATABASE_URL="file:./dev.db"

# NextAuth — generate a long random string for production
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Single staff login (v1 has no guest accounts)
ADMIN_EMAIL="admin@zigsastays.com"
ADMIN_PASSWORD="change-me"

# Razorpay (optional). If missing, guests see a pay-at-property / WhatsApp fallback.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Resend (optional). If missing, bookings still confirm without email.
RESEND_API_KEY=""
EMAIL_FROM="Zigsa Stays <bookings@example.com>"
STAFF_NOTIFY_EMAIL=""
